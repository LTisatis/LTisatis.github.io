---
import CharacterPuppet from "./CharacterPuppet.astro";
---
<div class="pink-veil" aria-hidden="true"></div>
<button id="welcome-entry" class="welcome-entry" type="button" aria-label="欢迎来到LTisatis的博客，点击进入" data-pagefind-ignore>
  <span class="welcome-copy"><span class="welcome-kicker">A LITTLE CORNER OF MY WORLD</span><span class="welcome-title">欢迎来到<span>LTisatis的博客</span></span><span class="welcome-line"></span><span class="welcome-caption">心得、随想，还有喜欢的每一天。</span><span class="welcome-enter">点击任意位置进入 <span aria-hidden="true">→</span></span></span>
</button>
<div class="character-stage" data-pagefind-ignore>
  <CharacterPuppet character="yasuna" />
  <CharacterPuppet character="sonya" />
  <button class="character-wave-control" data-wave-character="yasuna" type="button" disabled>让安奈招手</button>
  <button class="character-wave-control" data-wave-character="sonya" type="button" disabled>让索尼娅招手</button>
</div>
<button id="music-launcher" class="music-launcher" type="button" aria-label="打开音乐与动效设置" aria-expanded="false" aria-controls="music-player" data-pagefind-ignore>
  <img src="/media/cover-small.webp" alt="" width="44" height="44" /><span aria-hidden="true">♫</span>
</button>
<aside id="music-player" class="music-player" aria-label="音乐与动效设置" data-pagefind-ignore>
  <div class="music-mobile-heading"><strong>音乐与动效</strong><button id="music-close" type="button" aria-label="关闭音乐与动效设置">关闭</button></div>
  <div class="music-topline">
    <img src="/media/cover-small.webp" alt="WAAAA! 音频内嵌封面" width="48" height="48" />
    <div class="music-title"><strong>WAAAA!</strong><span>GYARI · 鏡音リン & 鏡音レン</span></div>
    <button id="music-toggle" type="button" aria-label="播放背景音乐" aria-pressed="false" title="播放 / 暂停背景音乐">
      <svg class="play-symbol" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5.5v13l10-6.5z" /></svg>
      <svg class="pause-symbol" viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="5" width="4" height="14" rx="1.5"/><rect x="14" y="5" width="4" height="14" rx="1.5"/></svg>
    </button>
    <button id="music-expand" type="button" aria-label="展开播放器" aria-expanded="false" aria-controls="music-details">⌃</button>
  </div>
  <div id="music-details" hidden>
    <label class="music-progress">进度 <input id="music-seek" type="range" min="0" max="100" value="0" step="0.1" /><span id="music-time">0:00</span></label>
    <label>音量 <input id="music-volume" type="range" min="0" max="1" step="0.01" value="0.35" /></label>
    <p id="music-status" role="status">点击播放，让随想有一点旋律。</p>
  </div>
  <button id="mobile-motion-toggle" class="mobile-motion-toggle" data-motion-toggle type="button" aria-pressed="false">开启动效</button>
  <audio id="background-audio" data-src="/media/waaaa-web.m4a" preload="none" loop></audio>
</aside>
<button id="motion-toggle" class="motion-toggle" data-motion-toggle type="button" aria-pressed="false">暂停动效</button>
<script src="../scripts/atmosphere.ts"></script>
<script src="../scripts/welcome.ts"></script>
