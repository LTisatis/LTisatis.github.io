---
import ArchivePanel from "@components/ArchivePanel.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPostsList, getTagList, getCategoryList } from "../utils/content-utils";

const sortedPostsList = await getSortedPostsList();
const tags = await getTagList();
const categories = await getCategoryList();
---

<MainGridLayout title={i18n(I18nKey.archive)}>
    <section class="card-base p-5 mb-4 text-75"><h1 class="text-2xl font-bold text-90 mb-4">文章归档</h1><div class="flex flex-wrap gap-3"><a href="/archive/" class="link">全部文章</a>{categories.map(c => <a class="link" href={c.url}>{c.name} · {c.count}</a>)}</div><div class="flex flex-wrap gap-3 mt-4">{tags.map(t => <a class="link" href={`/archive/?tag=${encodeURIComponent(t.name)}`}>#{t.name}</a>)}</div></section>
    <ArchivePanel sortedPosts={sortedPostsList} client:only="svelte"></ArchivePanel>
</MainGridLayout>

