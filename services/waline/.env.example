# Configure these in Vercel. Do not commit real credentials.
SITE_NAME=LTisatisのblog
SITE_URL=https://ltisatis.github.io
# Fill the actual assigned Vercel domain before deploying:
SERVER_URL=
SECURE_DOMAINS=ltisatis.github.io,localhost,127.0.0.1
COMMENT_AUDIT=false
IPQPS=60
DISABLE_USERAGENT=true
DISABLE_REGION=true
DISABLE_AUTHOR_NOTIFY=true
# No external anti-spam forwarding; guests publish immediately, with IP throttling.
AKISMET_KEY=false
MARKDOWN_CONFIG={"html":false,"linkify":true,"breaks":true}
# Neon connection details (or the equivalent POSTGRES_* integration variables):
PG_HOST=
PG_PORT=5432
PG_DB=
PG_USER=
PG_PASSWORD=
PG_SSL=true
