# Backend environment only. Never upload a real .env file as public content.
WALINE_SITE_NAME=LTisatisのblog
SITE_URL=https://ltisatis.github.io
SERVER_URL=https://YOUR-SITE.netlify.app/.netlify/functions/comment
SECURE_DOMAINS=ltisatis.github.io,localhost,127.0.0.1,YOUR-SITE.netlify.app
COMMENT_AUDIT=false
IPQPS=60
DISABLE_USERAGENT=true
DISABLE_REGION=true
DISABLE_AUTHOR_NOTIFY=true
AKISMET_KEY=false
MARKDOWN_CONFIG={"html":false,"linkify":true,"breaks":true}
NODE_OPTIONS=--experimental-require-module
PG_PORT=5432
PG_SSL=true
# Reuse the existing Neon connection, never initialize its schema again.
PG_HOST=
PG_DB=
PG_USER=
PG_PASSWORD=
